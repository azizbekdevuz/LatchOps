# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/latchops

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret

# CLI authentication (Phase 4C)
# Required in production — used to HMAC-hash CLI bearer tokens at rest.
LATCHOPS_TOKEN_PEPPER=generate-a-long-random-pepper-distinct-from-nextauth-secret
# Local dev only: allow anonymous legacy POST /api/snapshots/ingest (CLI always requires token)
LATCHOPS_ALLOW_ANONYMOUS_INGEST=false
# Set true only when the app runs behind a trusted reverse proxy that sets X-Forwarded-For
LATCHOPS_TRUST_PROXY=false
PHASE4_DUAL_WRITE=false
PHASE4_READ_SOURCE=new
# Phase 4D end: new-only writes (set true to keep writing GitSession/Analysis/Trace)
PHASE4_LEGACY_WRITES=false

# OAuth providers (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# NOTE: LatchOps analysis is fully deterministic and runs in-process
# (@latchops/state-engine + @latchops/recovery-engine). There is no Python
# service and no LLM dependency in Phase 3. A natural-language explanation
# layer (Anthropic) is planned for Phase 8.

# HackSprint Recovery Proof (optional sponsors)
# Daytona: isolated sandbox execution. Never reported live unless create() succeeds.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# HACKSPRINT_ISOLATION=auto
# Nosana: explanation only. Proof still works if this is unset.
NOSANA_API_KEY=
# Shared Preview/demo link token. Required on Vercel. Judges open /hacksprint?access=<token>
# HACKSPRINT_DEMO_TOKEN=
# Durable prove rate limit (Vercel KV or Upstash Redis REST). Do not use an in-memory counter.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# On Vercel, honor X-Forwarded-For for per-IP prove limits:
# LATCHOPS_TRUST_PROXY=true
